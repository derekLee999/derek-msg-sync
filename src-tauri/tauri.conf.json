{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "验证码接收器",
  "version": "0.0.1",
  "identifier": "com.derek.msgsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "验证码接收器",
        "width": 774,
        "height": 680,
        "minWidth": 774,
        "minHeight": 560,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "d1448db1-3655-5ddb-a258-5827520904b0"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
